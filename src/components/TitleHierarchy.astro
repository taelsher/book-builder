---
// Reproduces the reference site's per-chapter-page title block (see
// reference/notes.md "Title hierarchy"): chapter graphic -> bold chapter
// name -> "Chapter N" flanked by rules -> italic page title. Used as an MDX
// component at the top of each content page (registered in components.ts).
interface Props {
  chapterTitle: string;
  chapterNumber: number;
  title: string;
}

const { chapterTitle, chapterNumber, title } = Astro.props;
---

<div class="mt-4 mb-8">
  <h2
    class="mb-0 overflow-hidden border-b-0 pb-2 text-center font-bold! text-[1.75rem]! leading-none! text-black md:text-[2.375rem]! dark:text-white"
  >
    {chapterTitle}
  </h2>
  <div class="mt-3.5 flex w-full items-center">
    <div class="relative flex-1">
      <div class="absolute top-1/2 w-full border-black border-b dark:border-white"></div>
    </div>
    <div class="px-2 font-normal text-black dark:text-white">
      <h4 class="m-0! text-sm text-black! md:text-[1.375rem]! dark:text-white!" style="font-weight:400">Chapter {chapterNumber}</h4>
    </div>
    <div class="relative flex-1">
      <div class="absolute top-1/2 w-full border-black border-b dark:border-white"></div>
    </div>
  </div>
</div>
{
  /* Blume's page template always renders its own `<h1>{title}</h1>` ahead of
     this component (hidden via theme.css) and there's no slot to suppress
     it — so this is deliberately a styled `role="heading"` div, not a
     second literal <h1>, keeping exactly one <h1> tag in the DOM while
     still exposing this visible text as the page's level-1 heading to
     assistive tech. */
}
<div aria-level="1" class="mt-6 mb-4 italic text-black! leading-none! dark:text-white!" role="heading" style="font-weight:400;font-size:2.5rem">{title}</div>
